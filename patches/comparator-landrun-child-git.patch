--- a/Main.lean
+++ b/Main.lean
@@ -80,0 +81,28 @@
+/--
+Return the shared libraries needed to execute `binary`. Landrun's `--ldd` flag
+only expands the top-level sandbox command. `lake build` launches `git` as a
+child process while materializing dependencies, so Git's loader and shared
+libraries must be granted execute permission explicitly as well.
+-/
+def queryDynamicLibraryPaths (binary : System.FilePath) : IO (Array System.FilePath) := do
+  let out ← IO.Process.output {
+    cmd := "ldd",
+    args := #[binary.toString],
+  }
+  if out.exitCode != 0 then
+    throw <| .userError s!"ldd failed for {binary}:\n{out.stderr}"
+  let mut paths := #[]
+  for rawLine in out.stdout.split (· == '\n') do
+    let parts : List String :=
+      (rawLine.trimAscii.toString.split (· == ' ') |>.filterMap fun part =>
+        let part := part.trimAscii.toString
+        if part.isEmpty then none else some part).toList
+    let path? :=
+      match parts with
+      | _name :: "=>" :: path :: _ => some path
+      | path :: _ => if path.startsWith "/" then some path else none
+      | _ => none
+    if let some path := path? then
+      paths := paths.push path
+  return paths
+
@@ -120,0 +149 @@
+  let gitRuntimeLibraries ← queryDynamicLibraryPaths gitLocation
@@ -132 +161 @@
-    executablePaths := #[leanPrefix, gitLocation]
+    executablePaths := #[leanPrefix, gitLocation] ++ gitRuntimeLibraries
